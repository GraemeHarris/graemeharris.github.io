---
export interface Props {
  tag: string;
  size?: "sm" | "lg";
}

const { tag, size = "sm" } = Astro.props;
---

<li
  class={`inline-block ${
    size === "sm" ? "my-1 underline-offset-4" : "my-3 mx-1 underline-offset-8"
  }`}
>
  <a
    href={`/tags/${tag}/`}
    transition:name={tag}
    class={`${size === "sm" ? "text-sm" : "text-lg"} group pr-2`}
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class={size === "sm" ? "hash-sm" : "hash-lg"}
      ><path
        d="M16.018 3.815 15.232 8h-4.966l.716-3.815-1.964-.37L8.232 8H4v2h3.857l-.751 4H3v2h3.731l-.714 3.805 1.965.369L8.766 16h4.966l-.714 3.805 1.965.369.783-4.174H20v-2h-3.859l.751-4H21V8h-3.733l.716-3.815-1.965-.37zM14.106 14H9.141l.751-4h4.966l-.752 4z"
      ></path>
    </svg>
    <span>{tag}</span>
  </a>
</li>

<style>
  @reference "../styles/base.css";
  /* Laid out as a flex row with a real gap: the theme's original negative
     margin pulled the hash glyph on top of the first letter of the tag. */
  a {
    @apply relative inline-flex items-center gap-1 underline decoration-dashed
      hover:-top-0.5 hover:text-skin-accent focus-visible:p-1;
  }
  a svg {
    @apply shrink-0 text-skin-base opacity-80 group-hover:fill-skin-accent;
  }
  a svg.hash-sm {
    @apply h-4 w-4;
  }
  a svg.hash-lg {
    @apply h-5 w-5;
  }
</style>
