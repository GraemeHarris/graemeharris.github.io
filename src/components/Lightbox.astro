---
// Drop-in image lightbox. Any <img> inside #article becomes clickable and
// opens enlarged in a modal. Close by clicking anywhere, pressing Escape, or
// hitting the close button. Works on first load and across view transitions.
---

<div
  id="lightbox"
  class="lightbox"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  aria-label="Image viewer"
>
  <button id="lightbox-close" class="lightbox__close" aria-label="Close image"
    >&times;</button
  >
  <!-- The enlarged <img> is created in the script so Astro doesn't try to
       optimize an empty placeholder. -->
</div>

<style is:global>
  @reference "../styles/base.css";

  /* Make article images feel clickable. */
  #article img {
    cursor: zoom-in;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2.5rem;
    background: rgb(0 0 0 / 0.88);
    cursor: zoom-out;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.25s ease,
      visibility 0.25s ease;
  }

  .lightbox.is-open {
    opacity: 1;
    visibility: visible;
  }

  .lightbox__img {
    max-width: 95vw;
    max-height: 90vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 0.25rem;
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.55);
    transform: scale(0.92);
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .lightbox.is-open .lightbox__img {
    transform: scale(1);
  }

  .lightbox__close {
    position: absolute;
    top: 1rem;
    right: 1.25rem;
    line-height: 1;
    font-size: 2.25rem;
    color: rgb(255 255 255 / 0.85);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.25rem 0.5rem;
  }
  .lightbox__close:hover {
    color: #fff;
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox,
    .lightbox__img {
      transition: none;
    }
  }
</style>

<script is:inline>
  function setupLightbox() {
    const lightbox = document.getElementById("lightbox");
    const closeBtn = document.getElementById("lightbox-close");
    if (!lightbox) return;

    let lightboxImg = document.getElementById("lightbox-img");
    if (!lightboxImg) {
      lightboxImg = document.createElement("img");
      lightboxImg.id = "lightbox-img";
      lightboxImg.className = "lightbox__img";
      lightboxImg.alt = "";
      lightbox.appendChild(lightboxImg);
    }

    function openLightbox(src, alt) {
      lightboxImg.src = src;
      lightboxImg.alt = alt || "";
      lightbox.classList.add("is-open");
      lightbox.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    }

    function closeLightbox() {
      lightbox.classList.remove("is-open");
      lightbox.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    }

    const images = document.querySelectorAll("#article img");
    images.forEach(img => {
      if (img.dataset.lightboxBound) return;
      img.dataset.lightboxBound = "true";
      img.addEventListener("click", () => {
        openLightbox(img.currentSrc || img.src, img.alt);
      });
    });

    // Clicking anywhere on the overlay (including the image) closes it.
    // (#lightbox is a fresh node after each view-transition swap, so these
    // element-level listeners don't accumulate.)
    lightbox.addEventListener("click", closeLightbox);
    closeBtn?.addEventListener("click", closeLightbox);

    // document persists across navigations — bind the key handler only once.
    if (!window.__lightboxKeyBound) {
      window.__lightboxKeyBound = true;
      document.addEventListener("keydown", e => {
        if (e.key === "Escape") {
          document.getElementById("lightbox")?.classList.remove("is-open");
          document
            .getElementById("lightbox")
            ?.setAttribute("aria-hidden", "true");
          document.body.style.overflow = "";
        }
      });
    }
  }

  // Runs on first load and after every view-transition navigation.
  document.addEventListener("astro:page-load", setupLightbox);
</script>
